flowchart LR
    R[Generate a personalised study timetable] --> T1[1. Collect inputs]
    R --> T2[2. Validate inputs]
    R --> T3[3. Compute planning context]
    R --> T4[4. Generate plan with LLM]
    R --> T5[5. Check the plan]
    R --> T6[6. Present and revise]
    T2 --> T2a[missing / duplicate subjects]
    T2 --> T2b[past or invalid exam dates]
    T2 --> T2c[negative / zero hours]
    T2 --> T2d[same-day exam warning]
    T3 --> T3a[list study dates up to last exam]
    T3 --> T3b[hours per date: weekday/weekend,<br/>half day on exam days, blocked dates]
    T3 --> T3c[subjects still allowed per date]
    T3 --> T3d[difficulty-weighted target hours<br/>+ insufficient-time warnings]
    T4 --> T4a[P1: role + hard constraints + soft goals]
    T4 --> T4b[JSON schema + one-day example]
    T5 --> T5a[hours per day within limit]
    T5 --> T5b[no study on/after exam date]
    T5 --> T5c[no overlapping sessions]
    T5 --> T5d[every subject revised]
    T6 --> T6a[day-wise table + chart + downloads]
    T6 --> T6b[P2 regeneration with change request]
    classDef llm fill:#e8defc,stroke:#7c4dff;
    class T4,T4a,T4b,T6b llm;
